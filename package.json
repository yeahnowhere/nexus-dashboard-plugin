{
	"name": "nexus-dashboard",
	"version": "1.3.0",
	"description": "ASCII art banners + theme-aware dashboard for your vault.",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"deploy": "node scripts/deploy.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src/",
		"format": "prettier --write src/",
		"format:check": "prettier --check src/",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "Raspsec",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.1",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.0.0",
		"happy-dom": "^15.11.7",
		"obsidian": "1.13.1",
		"prettier": "^3.0.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vitest": "^3.0.0"
	}
}
